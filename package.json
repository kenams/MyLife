{
  "name": "mylife",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "npm --prefix workers run typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:mobile": "playwright test --project=pixel5 --project=iphone-13 --project=narrow-320",
    "test:e2e:headed": "playwright test --headed --project=pixel5",
    "test:e2e:prod": "cross-env E2E_TARGET=prod playwright test --project=pixel5 e2e/smoke.spec.ts e2e/idle-demo.spec.ts",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.1",
    "@expo/vector-icons": "~14.0.4",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@supabase/supabase-js": "^2.49.8",
    "@tanstack/react-query": "^5.62.7",
    "expo": "~52.0.19",
    "expo-asset": "~11.0.5",
    "expo-constants": "~17.0.3",
    "expo-font": "~13.0.4",
    "expo-haptics": "~14.0.1",
    "expo-linking": "~7.0.5",
    "expo-location": "~18.0.10",
    "expo-notifications": "~0.29.14",
    "expo-router": "~4.0.17",
    "expo-status-bar": "~2.0.1",
    "leaflet": "^1.9.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-leaflet": "^4.2.1",
    "react-native": "0.76.9",
    "react-native-maps": "1.18.0",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-web": "~0.19.13",
    "supercluster": "^9.0.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.12",
    "@types/supercluster": "^7.1.3",
    "cross-env": "^10.1.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.4"
  }
}
